&GLOBAL
  PROJECT SiO2_101_opt
  RUN_TYPE GEO_OPT
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 100
      MAX_DIIS 7
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          PARAMETER_FILE_NAME dftd3.dat
          TYPE DFTD3(BJ)
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
    &KPOINTS
      SCHEME MONKHORST-PACK 3 3 1
    &END KPOINTS
  &END DFT
  &SUBSYS
    &CELL
      A     4.916000     0.000000     0.000000
      B     0.000000     6.880357     0.000000
      C     0.000000     0.000000    39.328000
      PERIODIC XYZ
    &END CELL
    &COORD
      Si      1.999692      0.000000     15.826853
      Si      2.257689      3.603333      8.452853
      Si      1.999692      3.603333     10.910853
      Si      2.257689      1.801667     13.368853
      Si      0.000000      0.000000     14.374421
      Si      0.000000      1.801667     14.374421
      O      1.760427      4.761265      7.445073
      O      3.633249      2.959598      7.934952
      O      0.624132      4.247069     10.392952
      O      2.496954      2.445402      9.903073
      O      1.136295      0.643736     13.442101
      O      3.121086      1.157931     10.984101
      Si      1.999692      0.000000     20.742853
      Si      2.257689      3.603333     13.368853
      Si      1.999692      3.603333     15.826853
      Si      2.257689      1.801667     18.284853
      Si      0.000000      0.000000     19.290421
      Si      0.000000      1.801667     19.290421
      O      1.760427      4.761265     12.361073
      O      3.633249      2.959598     12.850952
      O      0.624132      4.247069     15.308952
      O      2.496954      2.445402     14.819073
      O      1.136295      0.643736     18.358101
      O      3.121086      1.157931     15.900101
      Si      1.999692      0.000000     25.658853
      Si      2.257689      3.603333     18.284853
      Si      1.999692      3.603333     20.742853
      Si      2.257689      1.801667     23.200853
      Si      0.000000      0.000000     24.206421
      Si      0.000000      1.801667     24.206421
      O      1.760427      4.761265     17.277073
      O      3.633249      2.959598     17.766952
      O      0.624132      4.247069     20.224952
      O      2.496954      2.445402     19.735073
      O      1.136295      0.643736     23.274101
      O      3.121086      1.157931     20.816101
    &END COORD
    &KIND O
      ELEMENT O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND Si
      ELEMENT Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 200
    MAX_DR 3.0E-3
    MAX_FORCE 4.5E-4
    RMS_DR 1.5E-3
    RMS_FORCE 3.0E-4
  &END GEO_OPT
  &PRINT
    &TRAJECTORY
      &EACH
        GEO_OPT 1
      &END EACH
    &END TRAJECTORY
  &END PRINT
&END MOTION