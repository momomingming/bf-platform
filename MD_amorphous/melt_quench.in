# LAMMPS input: Melt-quench amorphous basalt fiber
# Buckingham + Coulomb potential for silicate glass system
# SiO2-Al2O3-Fe2O3-CaO-MgO-Na2O-TiO2

units           metal
atom_style      charge
boundary        p p p
read_data       basalt_fiber.data

# ---- Potential: Buckingham + Coulomb (long-range) ----
pair_style      hybrid/overlay buck/coul/long 12.0 12.0

# Short-range Buckingham parameters (Teter/Du/Trinkas parameters for silicates)
# V(r) = A*exp(-r/rho) - C/r^6
# Si-O (type 1-8)
pair_coeff      1 8 buck/coul/long 1001.3929 0.2910 0.0
# Al-O (type 2-8)
pair_coeff      2 8 buck/coul/long 1200.4198 0.2990 0.0
# Fe-O (type 3-8)
pair_coeff      3 8 buck/coul/long 1155.4560 0.3020 0.0
# Ca-O (type 4-8)
pair_coeff      4 8 buck/coul/long 978.7393 0.3220 0.0
# Mg-O (type 5-8)
pair_coeff      5 8 buck/coul/long 821.6200 0.2990 0.0
# Na-O (type 6-8)
pair_coeff      6 8 buck/coul/long 788.6431 0.3390 0.0
# Ti-O (type 7-8)
pair_coeff      7 8 buck/coul/long 1300.0000 0.2950 0.0
# O-O (type 8-8) - includes repulsion and dispersion
pair_coeff      8 8 buck/coul/long 2029.2205 0.2650 24.0

# All cation-cation pairs (zero Buckingham, only Coulomb)
pair_coeff      1 1 buck/coul/long 0.0 1.0 0.0
pair_coeff      1 2 buck/coul/long 0.0 1.0 0.0
pair_coeff      1 3 buck/coul/long 0.0 1.0 0.0
pair_coeff      1 4 buck/coul/long 0.0 1.0 0.0
pair_coeff      1 5 buck/coul/long 0.0 1.0 0.0
pair_coeff      1 6 buck/coul/long 0.0 1.0 0.0
pair_coeff      1 7 buck/coul/long 0.0 1.0 0.0
pair_coeff      2 2 buck/coul/long 0.0 1.0 0.0
pair_coeff      2 3 buck/coul/long 0.0 1.0 0.0
pair_coeff      2 4 buck/coul/long 0.0 1.0 0.0
pair_coeff      2 5 buck/coul/long 0.0 1.0 0.0
pair_coeff      2 6 buck/coul/long 0.0 1.0 0.0
pair_coeff      2 7 buck/coul/long 0.0 1.0 0.0
pair_coeff      3 3 buck/coul/long 0.0 1.0 0.0
pair_coeff      3 4 buck/coul/long 0.0 1.0 0.0
pair_coeff      3 5 buck/coul/long 0.0 1.0 0.0
pair_coeff      3 6 buck/coul/long 0.0 1.0 0.0
pair_coeff      3 7 buck/coul/long 0.0 1.0 0.0
pair_coeff      4 4 buck/coul/long 0.0 1.0 0.0
pair_coeff      4 5 buck/coul/long 0.0 1.0 0.0
pair_coeff      4 6 buck/coul/long 0.0 1.0 0.0
pair_coeff      4 7 buck/coul/long 0.0 1.0 0.0
pair_coeff      5 5 buck/coul/long 0.0 1.0 0.0
pair_coeff      5 6 buck/coul/long 0.0 1.0 0.0
pair_coeff      5 7 buck/coul/long 0.0 1.0 0.0
pair_coeff      6 6 buck/coul/long 0.0 1.0 0.0
pair_coeff      6 7 buck/coul/long 0.0 1.0 0.0
pair_coeff      7 7 buck/coul/long 0.0 1.0 0.0

# Long-range Coulomb (PPPM)
kspace_style    pppm 1.0e-5

# ---- Neighbor list ----
neighbor        2.0 bin
neigh_modify    delay 5

# ---- Equilibration at 300K first ----
reset_timestep  0
velocity        all create 300.0 12345 mom yes rot yes

fix             1 all nvt temp 300.0 300.0 0.1
thermo          100
thermo_style    custom step temp pe ke etotal press vol density
thermo_modify   lost ignore

run             5000   # 5 ps equilibration at 300K
unfix           1

# ---- Melt at 3000K ----
reset_timestep  0
velocity        all create 3000.0 54321 mom yes rot yes

fix             2 all nvt temp 3000.0 3000.0 0.1
thermo          200

run             20000  # 20 ps at 3000K (melt)
unfix           2

# ---- Quench: 3000K -> 300K over 50 ps ----
reset_timestep  0

fix             3 all nvt temp 3000.0 300.0 0.1
thermo          500

run             50000  # 50 ps quench
unfix           3

# ---- Final equilibration at 300K ----
reset_timestep  0

fix             4 all npt temp 300.0 300.0 0.1 iso 1.0 1.0 1.0
thermo          100

run             10000  # 10 ps NPT at 300K
unfix           4

# ---- Save final structure ----
write_data      basalt_fiber_quenched.data
write_dump      all custom basalt_fiber_quenched.xyz id type x y z

print "=== Melt-quench simulation complete ==="
