&GLOBAL
  PROJECT Fe2O3_bulk_opt
  RUN_TYPE GEO_OPT
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    UKS
    MULTIPLICITY 13
    &MGRID
      CUTOFF 450
      REL_CUTOFF 60
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 100
      MAX_DIIS 7
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          PARAMETER_FILE_NAME dftd3.dat
          TYPE DFTD3(BJ)
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
    &KPOINTS
      SCHEME MONKHORST-PACK 3 3 2
    &END KPOINTS
  &END DFT
  &SUBSYS
    &CELL
      A     5.038000     0.000000     0.000000
      B    -2.519000     4.363036     0.000000
      C     0.000000     0.000000    13.772000
      PERIODIC XYZ
    &END CELL
    &COORD
      Fe     -0.000000      2.908691      7.188525
      Fe      0.000000      0.000000     11.779192
      Fe      2.519000      1.454345      9.483858
      Fe      0.000000      0.000000      1.992808
      Fe      0.000000      0.000000      4.893192
      Fe      0.000000      0.000000      8.878808
      Fe     -0.000000      2.908691      4.288142
      Fe      2.519000      1.454345      6.583475
      Fe      2.519000      1.454345     13.469475
      Fe      2.519000      1.454345      2.597858
      Fe     -0.000000      2.908691      0.302525
      Fe     -0.000000      2.908691     11.174142
      O     -1.541124      2.908691      5.738333
      O      0.770562      1.334653     10.329000
      O      3.496876      0.000000     10.329000
      O      4.060124      1.454345      8.033667
      O     -0.770562      1.334653      3.443000
      O      1.748438      3.028383      3.443000
      O      1.541124      0.000000      3.443000
      O      0.770562      1.574038      5.738333
      O      0.770562      4.243343      5.738333
      O     -1.748438      3.028383     10.329000
      O      1.748438      2.788998      8.033667
      O      1.748438      0.119693      8.033667
      O      0.977876      1.454345      1.147667
      O      3.289562      0.119693      1.147667
      O      3.289562      2.788998      1.147667
      O      1.541124      2.908691     12.624333
      O     -0.770562      4.243343     12.624333
      O     -0.770562      1.574038     12.624333
    &END COORD
    &KIND Fe
      ELEMENT Fe
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q16
    &END KIND
    &KIND O
      ELEMENT O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 300
    MAX_DR 3.0E-3
    MAX_FORCE 4.5E-4
    RMS_DR 1.5E-3
    RMS_FORCE 3.0E-4
  &END GEO_OPT
  &PRINT
    &TRAJECTORY
      &EACH
        GEO_OPT 1
      &END EACH
    &END TRAJECTORY
  &END PRINT
&END MOTION
