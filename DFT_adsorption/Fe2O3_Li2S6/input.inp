&GLOBAL
  PROJECT Fe2O3_Li2S6_ads_opt
  RUN_TYPE GEO_OPT
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    UKS
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 150
      MAX_DIIS 7
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        NBROYDEN 12
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          PARAMETER_FILE_NAME dftd3.dat
          TYPE DFTD3(BJ)
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 1
    &END KPOINTS
  &END DFT
  &SUBSYS
    &CELL
      A     5.038000     0.000000     0.000000
      B    -2.519000     4.363036     0.000000
      C     0.000000     0.000000    41.316000
      PERIODIC XYZ
    &END CELL
    &COORD
      Fe     -0.000000      2.908691     20.960525
      Fe      0.000000      0.000000     25.551192
      Fe      2.519000      1.454345     23.255858
      Fe      0.000000      0.000000     15.764808
      Fe      0.000000      0.000000     18.665192
      Fe      0.000000      0.000000     22.650808
      Fe     -0.000000      2.908691     18.060142
      Fe      2.519000      1.454345     20.355475
      Fe      2.519000      1.454345     27.241475
      Fe      2.519000      1.454345     16.369858
      Fe     -0.000000      2.908691     14.074525
      Fe     -0.000000      2.908691     24.946142
      O     -1.541124      2.908691     19.510333
      O      0.770562      1.334653     24.101000
      O      3.496876      0.000000     24.101000
      O      4.060124      1.454345     21.805667
      O     -0.770562      1.334653     17.215000
      O      1.748438      3.028383     17.215000
      O      1.541124      0.000000     17.215000
      O      0.770562      1.574038     19.510333
      O      0.770562      4.243343     19.510333
      O     -1.748438      3.028383     24.101000
      O      1.748438      2.788998     21.805667
      O      1.748438      0.119693     21.805667
      O      0.977876      1.454345     14.919667
      O      3.289562      0.119693     14.919667
      O      3.289562      2.788998     14.919667
      O      1.541124      2.908691     26.396333
      O     -0.770562      4.243343     26.396333
      O     -0.770562      1.574038     26.396333
      Li     -2.240500      1.056518     30.078975
      S     -1.240500      2.556518     29.878975
      S     -0.240500      2.989531     29.578975
      S      0.759500      2.989531     29.278975
      S      1.759500      2.556518     29.578975
      S      2.759500      2.123505     29.878975
      S      3.759500      2.123505     29.578975
      Li      4.759500      1.056518     30.078975
    &END COORD
    &KIND Fe
      ELEMENT Fe
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q16
    &END KIND
    &KIND Li
      ELEMENT Li
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND
    &KIND O
      ELEMENT O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND S
      ELEMENT S
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 300
    MAX_DR 3.0E-3
    MAX_FORCE 4.5E-4
    RMS_DR 1.5E-3
    RMS_FORCE 3.0E-4
  &END GEO_OPT
  &PRINT
    &TRAJECTORY
      &EACH
        GEO_OPT 1
      &END EACH
    &END TRAJECTORY
    &FORCES
      &EACH
        GEO_OPT 1
      &END EACH
    &END FORCES
  &END PRINT
&END MOTION