# ================================================================
# LAMMPS Input: MoS2-Basalt Fiber Binding Energy Calculation
# ================================================================
# Li-S battery BF separator modification study
# Binding energy: E_bind = E(MoS2+BF) - E(MoS2) - E(BF)
#
# Usage:
#   lmp -v system 0 -in MoS2_BF_binding.in   # combined MoS2+BF
#   lmp -v system 1 -in MoS2_BF_binding.in   # BF only
#   lmp -v system 2 -in MoS2_BF_binding.in   # MoS2 only
#
# Force field: Buckingham + Coulomb (PPPM)
# Units: metal (kcal/mol, Angstrom, ps, K)
# ================================================================

# ---- Initialization ----
units           metal
atom_style      charge
boundary        p p p

# System selector: 0=combined, 1=BF-only, 2=MoS2-only
variable        system equal 0
if              '${system} != 0 and ${system} != 1 and ${system} != 2' then &
                    'error "Invalid system: use -v system 0|1|2"'

# ---- Read combined structure ----
read_data       MoS2_BF_combined.data

# ---- Define groups ----
#   BF atoms:   IDs 1-201   (types 1-9)
#   MoS2 atoms: IDs 202-255 (types 10-11)
group           bf      id 1:201
group           mos2    id 202:255

# ---- Assign partial charges ----
# Basalt fiber cations (effective partial charges for silicate glass)
set type 1 charge 2.0    # Si
set type 2 charge 1.5    # Al
set type 3 charge 1.5    # Fe
set type 4 charge 1.5    # Ca
set type 5 charge 1.5    # Mg
set type 6 charge 0.8    # Na
set type 7 charge -1.2   # O
set type 8 charge -1.2   # (unused placeholder)
set type 9 charge 2.0    # Ti
# MoS2 (effective charges for MoS2 layer)
set type 10 charge 2.0   # Mo
set type 11 charge -1.0  # S

# ================================================================
# Pair potential: Buckingham + Coulomb (long-range)
# V(r) = A*exp(-r/rho) - C/r^6  +  Coulomb
# ================================================================
pair_style      hybrid/overlay buck/coul/long 12.0 12.0

# ---- BF: Cation-O Buckingham parameters ----
# (from Teter/Du/Trinkas silicate force field, metal units)
# Data file type mapping: 1=Si, 2=Al, 3=Fe, 4=Ca, 5=Mg, 6=Na, 7=O, 9=Ti
pair_coeff      1 7 buck/coul/long 1001.3929 0.2910 0.0    # Si-O
pair_coeff      2 7 buck/coul/long 1200.4198 0.2990 0.0    # Al-O
pair_coeff      3 7 buck/coul/long 1155.4560 0.3020 0.0    # Fe-O
pair_coeff      4 7 buck/coul/long  978.7393 0.3220 0.0    # Ca-O
pair_coeff      5 7 buck/coul/long  821.6200 0.2990 0.0    # Mg-O
pair_coeff      6 7 buck/coul/long  788.6431 0.3390 0.0    # Na-O
pair_coeff      7 7 buck/coul/long 2029.2205 0.2650 24.0   # O-O
pair_coeff      9 7 buck/coul/long 1300.0000 0.2950 0.0    # Ti-O

# ---- BF: Cation-cation pairs (Coulomb only, A=C=0) ----
pair_coeff 1 1 buck/coul/long 0.0 1.0 0.0
pair_coeff 1 2 buck/coul/long 0.0 1.0 0.0
pair_coeff 1 3 buck/coul/long 0.0 1.0 0.0
pair_coeff 1 4 buck/coul/long 0.0 1.0 0.0
pair_coeff 1 5 buck/coul/long 0.0 1.0 0.0
pair_coeff 1 6 buck/coul/long 0.0 1.0 0.0
pair_coeff 1 9 buck/coul/long 0.0 1.0 0.0
pair_coeff 2 2 buck/coul/long 0.0 1.0 0.0
pair_coeff 2 3 buck/coul/long 0.0 1.0 0.0
pair_coeff 2 4 buck/coul/long 0.0 1.0 0.0
pair_coeff 2 5 buck/coul/long 0.0 1.0 0.0
pair_coeff 2 6 buck/coul/long 0.0 1.0 0.0
pair_coeff 2 9 buck/coul/long 0.0 1.0 0.0
pair_coeff 3 3 buck/coul/long 0.0 1.0 0.0
pair_coeff 3 4 buck/coul/long 0.0 1.0 0.0
pair_coeff 3 5 buck/coul/long 0.0 1.0 0.0
pair_coeff 3 6 buck/coul/long 0.0 1.0 0.0
pair_coeff 3 9 buck/coul/long 0.0 1.0 0.0
pair_coeff 4 4 buck/coul/long 0.0 1.0 0.0
pair_coeff 4 5 buck/coul/long 0.0 1.0 0.0
pair_coeff 4 6 buck/coul/long 0.0 1.0 0.0
pair_coeff 4 9 buck/coul/long 0.0 1.0 0.0
pair_coeff 5 5 buck/coul/long 0.0 1.0 0.0
pair_coeff 5 6 buck/coul/long 0.0 1.0 0.0
pair_coeff 5 9 buck/coul/long 0.0 1.0 0.0
pair_coeff 6 6 buck/coul/long 0.0 1.0 0.0
pair_coeff 6 9 buck/coul/long 0.0 1.0 0.0
pair_coeff 9 9 buck/coul/long 0.0 1.0 0.0

# ---- MoS2 intra-pair parameters ----
# (converted from eV: 1 eV = 23.0605 kcal/mol)
# Mo-O (type 10-7): A=1200.0 eV=27672.6 kcal/mol, rho=0.32, C=0.0
pair_coeff      10 7  buck/coul/long 27672.6 0.32 0.0
# Mo-S (type 10-11): A=800.0 eV=18448.4 kcal/mol, rho=0.35, C=5.0 eV=115.3 kcal/mol
pair_coeff      10 11 buck/coul/long 18448.4 0.35 115.3
# S-O (type 11-7): A=1500.0 eV=34590.8 kcal/mol, rho=0.29, C=8.5 eV=196.0 kcal/mol
pair_coeff      11 7  buck/coul/long 34590.8 0.29 196.0
# S-Si (type 11-1): A=1100.0 eV=25366.6 kcal/mol, rho=0.31, C=6.0 eV=138.4 kcal/mol
pair_coeff      11 1  buck/coul/long 25366.6 0.31 138.4
# Mo-Mo (Coulomb only)
pair_coeff      10 10 buck/coul/long 0.0 1.0 0.0
# S-S (Coulomb only; Buckingham dispersion handled via O-O term overlay)
pair_coeff      11 11 buck/coul/long 0.0 1.0 0.0

# ---- Mo-cation cross pairs (Coulomb only) ----
pair_coeff 1 10 buck/coul/long 0.0 1.0 0.0    # Mo-Si
pair_coeff 10 2 buck/coul/long 0.0 1.0 0.0    # Mo-Al
pair_coeff 10 3 buck/coul/long 0.0 1.0 0.0    # Mo-Fe
pair_coeff 10 4 buck/coul/long 0.0 1.0 0.0    # Mo-Ca
pair_coeff 10 5 buck/coul/long 0.0 1.0 0.0    # Mo-Mg
pair_coeff 10 6 buck/coul/long 0.0 1.0 0.0    # Mo-Na
pair_coeff 10 9 buck/coul/long 0.0 1.0 0.0    # Mo-Ti

# ---- S-cation cross pairs (Buckingham, geometric mean from S-O/Si-O) ----
pair_coeff 11 2 buck/coul/long 29100.0 0.30 160.0   # S-Al
pair_coeff 11 3 buck/coul/long 28500.0 0.30 155.0   # S-Fe
pair_coeff 11 4 buck/coul/long 25000.0 0.32 140.0   # S-Ca
pair_coeff 11 5 buck/coul/long 23000.0 0.30 130.0   # S-Mg
pair_coeff 11 6 buck/coul/long 21000.0 0.33 120.0   # S-Na
pair_coeff 11 9 buck/coul/long 30000.0 0.30 165.0   # S-Ti

# ---- Unused type 8 pairs (Coulomb only) ----
pair_coeff 8 8  buck/coul/long 0.0 1.0 0.0
pair_coeff 1 8  buck/coul/long 0.0 1.0 0.0
pair_coeff 2 8  buck/coul/long 0.0 1.0 0.0
pair_coeff 3 8  buck/coul/long 0.0 1.0 0.0
pair_coeff 4 8  buck/coul/long 0.0 1.0 0.0
pair_coeff 5 8  buck/coul/long 0.0 1.0 0.0
pair_coeff 6 8  buck/coul/long 0.0 1.0 0.0
pair_coeff 7 8  buck/coul/long 0.0 1.0 0.0
pair_coeff 8 9  buck/coul/long 0.0 1.0 0.0
pair_coeff 8 10 buck/coul/long 0.0 1.0 0.0
pair_coeff 8 11 buck/coul/long 0.0 1.0 0.0

# ---- Long-range Coulomb (PPPM) ----
kspace_style    pppm 1.0e-5

# ---- Neighbor list ----
neighbor        2.0 bin
neigh_modify    delay 5

# ================================================================
# Simulation Protocol
# ================================================================

# Delete atoms for isolated-component calculations
if              '${system} == 1' then 'delete_atoms group mos2'
if              '${system} == 2' then 'delete_atoms group bf'

# ---- Step 1: Energy Minimization ----
reset_timestep  0
min_style       cg
minimize        1.0e-6 1.0e-8 10000 100000

print "=== Minimization complete (system=${system}) ==="

# ---- Step 2: NVT Equilibration at 300K (20 ps) ----
reset_timestep  0
velocity        all create 300.0 12345 mom yes rot yes

fix             1 all nvt temp 300.0 300.0 0.1
thermo          100
thermo_style    custom step temp pe ke etotal press vol density
thermo_modify   lost ignore

run             20000   # 20 ps (metal units: 1 timestep = 0.001 ps)
unfix           1

print "=== NVT equilibration complete (system=${system}) ==="

# ---- Step 3: NVT Production at 300K (50 ps) ----
reset_timestep  0

fix             2 all nvt temp 300.0 300.0 0.1
thermo          100
thermo_style    custom step temp pe ke etotal press vol density
thermo_modify   lost ignore

# Trajectory output
dump            1 all custom 5000 traj_system${system}.lammpstrj id type x y z
dump_modify     1 sort id

run             50000   # 50 ps production
unfix           2

# ---- Final energy ----
variable        E_final equal pe
print "=== Production run complete (system=${system}) ==="
print "Final potential energy: ${E_final} kcal/mol"

# ---- Save outputs ----
write_data      final_system${system}.data
write_restart   restart_system${system}.rst

print "=== All done for system=${system} ==="
print "Run all 3 cases, then use analyze_binding.py"
